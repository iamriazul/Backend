<%- include('partials/header') %>

<h2 class="text-3xl font-bold mb-4">Contact Us</h2>

<% if (typeof success !== 'undefined' && success) { %>
    <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 mb-6">
        <p class="font-bold">Success!</p>
        <p>Your message has been sent. Check your terminal console log.</p>
    </div>
<% } %>

<form action="/contact" method="POST" class="max-w-md bg-gray-50 p-6 rounded border shadow-sm mt-4">
    <div class="mb-4">
        <label for="name" class="block font-semibold mb-1 text-gray-700">Name:</label>
        <input type="text" id="name" name="name" required class="w-full border p-2 rounded focus:ring-blue-500 focus:border-blue-500">
    </div>
    
    <div class="mb-4">
        <label for="email" class="block font-semibold mb-1 text-gray-700">Email:</label>
        <input type="email" id="email" name="email" required class="w-full border p-2 rounded focus:ring-blue-500 focus:border-blue-500">
    </div>
    
    <div class="mb-4">
        <label for="message" class="block font-semibold mb-1 text-gray-700">Message:</label>
        <textarea id="message" name="message" rows="4" required class="w-full border p-2 rounded focus:ring-blue-500 focus:border-blue-500"></textarea>
    </div>
    
    <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 w-full mt-2 font-semibold">
        Submit
    </button>
</form>

<%- include('partials/footer') %>
